# Copy these into Vercel → Project → Settings → Environment Variables (or .env for `vercel dev`).
# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...            # public "anon" key (safe in the browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SECRET: server only. Never put this in the frontend.

# From console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...        # SECRET: server only

# Optional
APP_NAME=Exam Ready
AI_DAILY_LIMIT=80                   # AI requests per student per 24 hours
AI_MODEL=claude-sonnet-5-5          # tutor and theory marking
AI_MODEL_QUICK=claude-haiku-4-5-20251001   # trivia, quick checks
